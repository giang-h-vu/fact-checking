# Copy to .env and fill in.

# --- LLM (Ollama) -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b-instruct
OLLAMA_NUM_CTX=8192
# Smaller fallback for laptops without a beefy GPU:
# OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Search APIs ------------------------------------------------------------
# DuckDuckGo needs no key and is always available.
# Brave is optional — leave blank to disable. Free tier: https://brave.com/search/api/
BRAVE_API_KEY=

# --- Persistence ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./fact_checking.db

# --- HTTP behaviour ---------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
MAX_CONCURRENT_FETCHES=3
SEARCH_RESULTS_PER_QUERY=3

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
