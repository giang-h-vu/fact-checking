# Copy to .env and fill in.

# --- LLM --------------------------------------------------------------------
# LLM_PROVIDER=ollama (local) or openrouter (hosted API).
LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) --------------------------------------
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL is the single source of truth in docker-compose.yml (x-ollama-model anchor).
# When running the server natively, set it here.
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192

# --- OpenRouter (when LLM_PROVIDER=openrouter) ------------------------------
# Key: https://openrouter.ai/keys   Models: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Optional comma-separated fallbacks tried in order, e.g. free models (`:free` slugs).
OPENROUTER_FALLBACK_MODELS=

# --- Search APIs ------------------------------------------------------------
# DuckDuckGo needs no key and is always available.
# Brave is optional — leave blank to disable. Free tier: https://brave.com/search/api/
BRAVE_API_KEY=

# --- LangSmith tracing (optional) -------------------------------------------
# Off by default; tests force it off. When on, the raw fetched page text is scrubbed
# before upload and only the extracted passages are kept. Key: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fact-checking
# EU workspace only (leave unset otherwise; an empty value breaks the SDK default):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Persistence ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./fact_checking.db

# --- HTTP behaviour ---------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
MAX_CONCURRENT_FETCHES=3
SEARCH_RESULTS_PER_QUERY=3

# --- CORS -------------------------------------------------------------------
# Must list explicit origins (no "*") because auth uses credentialed requests.
CORS_ORIGINS=http://localhost:5173

# --- Auth (Google OAuth + JWT sessions) -------------------------------------
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console and add
# OAUTH_REDIRECT_URI to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173/

# Secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
SESSION_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
